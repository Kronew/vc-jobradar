# Lokal: kopieren nach .env und ausfüllen (.env ist in .gitignore)
# In GitHub Actions: dieselben Namen als Repository-Secrets anlegen.

# Mailversand (Gmail mit App-Passwort, siehe README)
SMTP_USER=deine.adresse@gmail.com
SMTP_APP_PASSWORD=
EMAIL_TO=deine.adresse@gmail.com

# KI-Bewertung, optional (https://platform.claude.com → API Keys)
ANTHROPIC_API_KEY=

# Nur lokal nötig, damit der Link „Einstellungen ändern“ stimmt (in GitHub Actions automatisch)
TRACKER_REPO=dein-name/dein-repo

<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f6;">
<tr><td align="center" style="padding:16px 8px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;">

  <tr><td style="padding:8px 4px 16px;">
    <div style="font-size:22px;font-weight:700;">🎯 {{ app_name }}</div>
    <div style="font-size:14px;color:#6b7280;margin-top:4px;">{{ date }} · {{ total }} neue Stelle{{ "" if total == 1 else "n" }}{% if scored %} · sortiert nach Relevanz{% endif %}</div>
  </td></tr>

  {% if total == 0 %}
  <tr><td style="background:#ffffff;border-radius:12px;padding:24px;font-size:15px;line-height:1.5;">
    Heute keine neuen Treffer. Morgen wieder! ☕
  </td></tr>
  {% endif %}

  {% for group in groups %}
  <tr><td style="padding:16px 4px 8px;">
    <div style="font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#4b5563;">{{ group.label }} ({{ group.jobs|length }})</div>
  </td></tr>
  {% for job in group.jobs %}
  <tr><td style="padding:0 0 12px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;border:1px solid #e5e7eb;">
      <tr><td style="padding:16px 16px 4px;">
        {% if job.score is not none %}
        <span style="display:inline-block;font-size:12px;font-weight:700;padding:2px 8px;border-radius:999px;background:{{ score_color(job.score) }};color:#ffffff;">{{ job.score }}/10</span>
        {% endif %}
        {% for t in job.job_types %}
        <span style="display:inline-block;font-size:12px;font-weight:600;padding:2px 8px;border-radius:999px;background:#e0f2fe;color:#075985;">{{ t }}</span>
        {% endfor %}
        <a href="{{ job.url }}" style="display:block;margin-top:6px;font-size:17px;font-weight:600;line-height:1.35;color:#1d4ed8;text-decoration:none;">{{ job.title }}</a>
      </td></tr>
      <tr><td style="padding:2px 16px;font-size:14px;line-height:1.5;color:#374151;">
        <strong>{{ job.company or "Unbekannte Firma" }}</strong> · {{ job.location_label }}
      </td></tr>
      {% if job.investors %}
      <tr><td style="padding:4px 16px 2px;">
        <span style="display:inline-block;font-size:13px;font-weight:600;padding:3px 10px;border-radius:999px;background:#ede9fe;color:#5b21b6;">💼 Portfolio von {{ job.investors|join(" · ") }}</span>
      </td></tr>
      {% endif %}
      <tr><td style="padding:2px 16px;font-size:12px;color:#6b7280;">
        {{ job.source }}{% if job.also_on %} (auch auf: {{ job.also_on|join(", ") }}){% endif %}{% if job.posted_at %} · {{ job.posted_at.strftime("%d.%m.%Y") }}{% endif %}{% if job.hours_ok is false %} · ⚠️ Stundenumfang prüfen{% endif %}
      </td></tr>
      {% if job.reason %}
      <tr><td style="padding:8px 16px 0;font-size:14px;line-height:1.45;color:#111827;font-style:italic;">„{{ job.reason }}“</td></tr>
      {% endif %}
      <tr><td style="padding:12px 16px 16px;">
        <a href="{{ job.url }}" style="display:inline-block;background:#1d4ed8;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;padding:10px 18px;border-radius:8px;">Jetzt bewerben →</a>
      </td></tr>
    </table>
  </td></tr>
  {% endfor %}
  {% endfor %}

  {% if truncated %}
  <tr><td style="padding:4px;font-size:13px;color:#6b7280;">… und {{ truncated }} weitere (Limit pro Mail erreicht).</td></tr>
  {% endif %}

  {% if settings_url %}
  <tr><td style="padding:16px 0 4px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;border:1px solid #e5e7eb;">
      <tr><td style="padding:16px 16px 8px;font-size:15px;font-weight:700;">⚙️ Deine Einstellungen</td></tr>
      {% for label, value in settings_summary %}
      <tr><td style="padding:1px 16px;font-size:13px;line-height:1.5;color:#374151;"><span style="color:#6b7280;">{{ label }}:</span> {{ value }}</td></tr>
      {% endfor %}
      <tr><td style="padding:12px 16px 16px;">
        <a href="{{ settings_url }}" style="display:inline-block;background:#f3f4f6;color:#111827;border:1px solid #d1d5db;font-size:14px;font-weight:600;text-decoration:none;padding:9px 16px;border-radius:8px;">Einstellungen ändern →</a>
        <div style="margin-top:8px;font-size:12px;color:#6b7280;">Ort, Bereiche, Profil oder Suchbegriffe anpassen – gilt ab der nächsten Mail.</div>
      </td></tr>
    </table>
  </td></tr>
  {% endif %}

  <tr><td style="padding:16px 4px;font-size:12px;line-height:1.5;color:#9ca3af;">
    {% if errors %}
    <div style="color:#b45309;margin-bottom:8px;">⚠️ Hinweise zu diesem Lauf:<br>
    {% for e in errors %}· {{ e.source }}: {{ e.message }}<br>{% endfor %}
    </div>
    {% endif %}
    {{ stats }}<br>
    Automatisch erstellt von {{ app_name }} · Stellen aus VC-Portfolio-Jobbörsen.
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
